{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/merge/**/*.js", "src/merge/**/*.d.ts"],
  "exclude": [
    "src/merge/vendor.js",
    "src/merge/game.js",
    "src/merge/offline-data.js"
  ]
}
